# Frontend only: use your Supabase project URL and publishable key here.
# Do not put an sb_secret_... or service role key in this file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Optional alias if you prefer the newer naming from the Supabase dashboard.
# VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional AI features. Leave blank to keep the app fully functional without AI helpers.
# VITE_GEMINI_API_KEY=your-google-ai-api-key
# VITE_GEMINI_MODEL=gemini-2.5-flash
